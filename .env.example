# ============================================
# Viralyze Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.
#

# --- Supabase (source: Supabase Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# --- Google OAuth (source: Google Cloud Console > Credentials) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Site URL (set this for OAuth callbacks in production) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Z.ai (required for predict + audience simulator) ---
Z_AI_API_KEY=your_z_ai_api_key
# Z_AI_BASE_URL=https://api.z.ai/api/paas/v4
# Z_AI_MODEL=glm-4.7-flash

# --- Optional social OAuth (audience connections). Omit to use Demo Mode. ---
# Instagram (Meta)
# META_APP_ID=
# META_APP_SECRET=
# YouTube reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# TikTok
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# X
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# LinkedIn
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
