# Database
DATABASE_URL=file:./db/custom.db

# AI Integration (provided by z-ai-web-dev-sdk — no separate API key needed)
# The SDK handles authentication internally when deployed on supported platforms.

# Supabase (optional — for future production database migration)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Authentication (for future Google OAuth integration)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Site URL (used for metadata/OG tags)
# NEXT_PUBLIC_SITE_URL=https://viralyze.com
